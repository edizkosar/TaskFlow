# Copy to .env.local and fill in real values. Never commit .env.local.

# Neon pooled connection (host contains "-pooler") — used by the app.
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/DB?sslmode=verify-full"

# Neon direct connection — used by Prisma migrations (prisma.config.ts).
DIRECT_URL="postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/DB?sslmode=verify-full"

# At least 32 random bytes:
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
BETTER_AUTH_SECRET=""

BETTER_AUTH_URL="http://localhost:3000"

# Optional: create .env.test.local with DATABASE_URL / DIRECT_URL of a Neon
# `test` branch so E2E tests (npm run test:e2e) do not write to your dev data.
